datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Event {
  id          String       @id @default(cuid())
  name        String
  status      String       @default("DRAFT") // DRAFT, LIVE, FINISHED
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  teams       Team[]
  rounds      Round[]
  scoreEvents ScoreEvent[]
  auditLogs   AuditLog[]
}

model Team {
  id                String                 @id @default(cuid())
  eventId           String
  event             Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  joinCode          String
  score             Int                    @default(0)
  scoreReachedAt    DateTime?
  wallet            Int                    @default(0)
  qualified         Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  members           TeamMember[]
  submissions       Submission[]
  scoreEvents       ScoreEvent[]
  hintClaims        HintClaim[]
  challengeAttempts TeamChallengeAttempt[]

  @@unique([eventId, joinCode])
  @@unique([eventId, name])
  @@index([eventId, score(sort: Desc), scoreReachedAt(sort: Asc)])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@index([teamId])
}

model Round {
  id                String             @id @default(cuid())
  eventId           String
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  number            Int
  status            String             @default("DRAFT") // DRAFT, READY, LIVE, PAUSED, FINISHED
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  questions         Question[]
  auctionChallenges AuctionChallenge[]
  scoreEvents       ScoreEvent[]

  @@index([eventId, number])
}

model Question {
  id          String       @id @default(cuid())
  roundId     String
  round       Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  title       String
  description String       @db.Text
  answer      String
  points      Int          @default(100)
  difficulty  String       @default("MEDIUM") // EASY, MEDIUM, HARD
  category    String       @default("General")
  releaseAt   DateTime
  closeAt     DateTime
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]

  @@index([roundId, order])
}

model Submission {
  id              String   @id @default(cuid())
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submittedAnswer String
  isCorrect       Boolean
  submittedAt     DateTime @default(now())
  submittedBy     String?

  @@index([teamId, questionId])
  @@index([questionId, isCorrect])
}

model ScoreEvent {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roundId   String?
  round     Round?   @relation(fields: [roundId], references: [id], onDelete: SetNull)
  type      String   // ROUND1_CORRECT, ROUND2_SUCCESS, SPEED_BONUS, HINT_COST, ROUND2_FAILURE, MANUAL_ADJUSTMENT
  points    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([eventId, teamId])
  @@index([teamId, createdAt])
}

model AuctionChallenge {
  id               String                 @id @default(cuid())
  roundId          String
  round            Round                  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  title            String
  description      String                 @db.Text
  basePoints       Int                    @default(200)
  status           String                 @default("DRAFT") // DRAFT, READY, LIVE, COMPLETED, FAILED
  winningTeamId    String?
  committedSeconds Int?
  startedAt        DateTime?
  deadlineAt       DateTime?
  completedAt      DateTime?
  success          Boolean?
  failurePenalty   Int                    @default(100)
  order            Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  hints            Hint[]
  attempts         TeamChallengeAttempt[]

  @@index([roundId, order])
}

model Hint {
  id          String            @id @default(cuid())
  challengeId String
  challenge   AuctionChallenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  title       String
  content     String            @db.Text
  cost        Int               @default(50)
  order       Int               @default(0)
  claims      HintClaim[]

  @@index([challengeId, order])
}

model HintClaim {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  hintId    String
  hint      Hint     @relation(fields: [hintId], references: [id], onDelete: Cascade)
  cost      Int
  claimedAt DateTime @default(now())

  @@unique([teamId, hintId])
  @@index([teamId])
}

model TeamChallengeAttempt {
  id              String           @id @default(cuid())
  teamId          String
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  challengeId     String
  challenge       AuctionChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  startedAt       DateTime
  deadlineAt      DateTime
  completedAt     DateTime?
  success         Boolean          @default(false)
  timeUsedSeconds Int?
  pointsAwarded   Int              @default(0)
  createdAt       DateTime         @default(now())

  @@index([teamId, success])
  @@index([challengeId])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId    String?
  actor     String   @default("SYSTEM") // ADMIN, TEAM, SYSTEM
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([actor, action])
}
