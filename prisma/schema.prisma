generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id           String        @id @default(cuid())
  name         String
  status       String        @default("DRAFT")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auditLogs    AuditLog[]
  rounds       Round[]
  scoreEvents  ScoreEvent[]
  teams        Team[]
  activityLogs ActivityLog[]
}

model Team {
  id                       String                     @id @default(cuid())
  eventId                  String
  name                     String
  joinCode                 String
  score                    Int                        @default(0)
  scoreReachedAt           DateTime?
  qualified                Boolean                    @default(false)
  round1StartedAt          DateTime?
  round1DeadlineAt         DateTime?
  round1Duration           Int                        @default(1800)
  
  // Manual hint tracking
  manualHintsR1            Int                        @default(0)
  manualHintsR2            Int                        @default(0)
  hintPenaltyApplied       Int                        @default(0)
  
  // Leaderboard control
  hideFromLeaderboard      Boolean                    @default(false)
  
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  hintClaims               HintClaim[]
  scoreEvents              ScoreEvent[]
  submissions              Submission[]
  event                    Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  challengeAttempts        TeamChallengeAttempt[]
  members                  TeamMember[]
  auctionBids              AuctionBid[]
  auctionSales             AuctionSale[]
  challengeAssignments     TeamChallengeAssignment[]
  activityLogs             ActivityLog[]

  @@unique([eventId, joinCode])
  @@unique([eventId, name])
  @@index([eventId, score(sort: Desc), scoreReachedAt])
  @@index([eventId])
  @@index([joinCode])
  @@index([round1DeadlineAt])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  phone     String?
  email     String?
  isLeader  Boolean  @default(false)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Round {
  id                String             @id @default(cuid())
  eventId           String
  name              String
  number            Int
  status            String             @default("DRAFT")
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auctionChallenges AuctionChallenge[]
  auctionQuestions  AuctionQuestion[]
  questions         Question[]
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scoreEvents       ScoreEvent[]

  @@index([eventId, number])
}

model Question {
  id                   String                @id @default(cuid())
  roundId              String
  title                String
  description          String
  answer               String
  points               Int                   @default(100)
  difficulty           String                @default("MEDIUM")
  category             String                @default("General")
  answerMode           String                @default("TRIMMED")
  
  // External CTF integration
  externalChallengeUrl String?
  outline              String?
  expectedFlag         String?
  answerNormalization  String                @default("TRIM_UPPERCASE")
  
  // Round 2 full content
  fullContent          String?
  
  // Admin fields
  adminNotes           String?
  
  isActive             Boolean               @default(true)
  isCore               Boolean               @default(true)
  isReleased           Boolean               @default(true)
  order                Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  round                Round                 @relation(fields: [roundId], references: [id], onDelete: Cascade)
  submissions          Submission[]
  hints                QuestionHint[]
  auctionQuestions     AuctionQuestion[]
  attachments          QuestionAttachment[]

  @@index([roundId, isCore, order])
  @@index([roundId, isReleased])
  @@index([roundId, isActive])
  @@index([isCore, isReleased])
}

model QuestionHint {
  id         String   @id @default(cuid())
  questionId String
  title      String
  content    String
  cost       Int      @default(2)
  order      Int      @default(1)
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  claims     HintClaim[]

  @@index([questionId, order])
}

model Submission {
  id              String   @id @default(cuid())
  teamId          String
  questionId      String
  submittedAnswer String
  normalizedAnswer String?
  isCorrect       Boolean
  submittedAt     DateTime @default(now())
  submittedBy     String?
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, questionId])
  @@index([teamId, questionId, isCorrect])
  @@index([questionId, isCorrect])
  @@index([submittedAt])
  @@index([teamId, submittedAt])
}

model ScoreEvent {
  id         String   @id @default(cuid())
  eventId    String
  teamId     String
  roundId    String?
  questionId String?
  type       String
  points     Int
  reason     String
  metadata   Json?
  createdAt  DateTime @default(now())
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round      Round?   @relation(fields: [roundId], references: [id])
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([eventId, teamId])
  @@index([teamId, createdAt])
  @@index([eventId, createdAt])
  @@index([type])
  @@index([questionId])
}

model AuctionChallenge {
  id               String                 @id @default(cuid())
  roundId          String
  title            String
  description      String
  basePoints       Int                    @default(200)
  status           String                 @default("DRAFT")
  winningTeamId    String?
  committedSeconds Int?
  startedAt        DateTime?
  deadlineAt       DateTime?
  completedAt      DateTime?
  success          Boolean?
  failurePenalty   Int                    @default(100)
  order            Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  round            Round                  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  hints            Hint[]
  attempts         TeamChallengeAttempt[]

  @@index([roundId, order])
}

model Hint {
  id          String           @id @default(cuid())
  challengeId String
  title       String
  content     String
  cost        Int              @default(50)
  order       Int              @default(0)
  challenge   AuctionChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  claims      HintClaim[]

  @@index([challengeId, order])
}

model HintClaim {
  id           String        @id @default(cuid())
  teamId       String
  hintId       String?       // For Round 2 auction challenge hints
  questionHintId String?     // For Round 1 question hints
  cost         Int
  claimedAt    DateTime      @default(now())
  hint         Hint?         @relation(fields: [hintId], references: [id], onDelete: Cascade)
  questionHint QuestionHint? @relation(fields: [questionHintId], references: [id], onDelete: Cascade)
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, hintId])
  @@unique([teamId, questionHintId])
  @@index([teamId])
}

model TeamChallengeAttempt {
  id              String           @id @default(cuid())
  teamId          String
  challengeId     String
  startedAt       DateTime
  deadlineAt      DateTime
  completedAt     DateTime?
  success         Boolean          @default(false)
  timeUsedSeconds Int?
  pointsAwarded   Int              @default(0)
  createdAt       DateTime         @default(now())
  challenge       AuctionChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, success])
  @@index([challengeId])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventId   String?
  teamId    String?
  actor     String   @default("SYSTEM")
  action    String
  details   String?
  createdAt DateTime @default(now())
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([actor, action])
}

model QuestionAttachment {
  id           String   @id @default(cuid())
  questionId   String
  filename     String
  originalName String
  mimeType     String
  fileSize     Int
  storageUrl   String
  uploadedAt   DateTime @default(now())
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  eventId   String?
  teamId    String?
  memberId  String?
  actor     String
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([teamId, createdAt])
  @@index([action])
}

model AuctionQuestion {
  id               String                    @id @default(cuid())
  roundId          String
  questionId       String
  title            String
  topic            String
  outline          String
  baseTimeSeconds  Int                       // Time for auction bidding display only, no scoring impact
  points           Int                       @default(200) // Admin-set points (NO TIME BONUS)
  hintPenalty      Int                       @default(-10) // Admin-set penalty per hint in Round 2 (e.g., -10, -15, -20)
  hasAttachments   Boolean                   @default(false)
  status           String                    @default("DRAFT")
  displayedAt      DateTime?
  auctionClosedAt  DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  round            Round                     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  question         Question                  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  bids             AuctionBid[]
  sale             AuctionSale?
  assignments      TeamChallengeAssignment[]

  @@index([roundId, status])
  @@index([status, displayedAt])
}

model AuctionBid {
  id                 String          @id @default(cuid())
  auctionQuestionId  String
  teamId             String
  bidTimeSeconds     Int
  submittedAt        DateTime        @default(now())
  auctionQuestion    AuctionQuestion @relation(fields: [auctionQuestionId], references: [id], onDelete: Cascade)
  team               Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([auctionQuestionId, bidTimeSeconds])
  @@index([teamId, submittedAt])
}

model AuctionSale {
  id                 String          @id @default(cuid())
  auctionQuestionId  String          @unique
  teamId             String
  winningBidSeconds  Int
  settledByAdminId   String?
  soldAt             DateTime        @default(now())
  auctionQuestion    AuctionQuestion @relation(fields: [auctionQuestionId], references: [id], onDelete: Cascade)
  team               Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, soldAt])
}

model TeamChallengeAssignment {
  id                 String          @id @default(cuid())
  teamId             String
  auctionQuestionId  String
  winningBidSeconds  Int             // Time they bid - for reference only, no scoring impact
  status             String          @default("READY")
  startedAt          DateTime?
  deadlineAt         DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  finalScoreChange   Int             @default(0) // Actual points awarded (admin-set points minus hint penalties)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  team               Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  auctionQuestion    AuctionQuestion @relation(fields: [auctionQuestionId], references: [id], onDelete: Cascade)

  @@unique([teamId, auctionQuestionId])
  @@index([teamId, status])
  @@index([status, startedAt])
  @@index([deadlineAt])
}
