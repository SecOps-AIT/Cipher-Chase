generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id          String       @id @default(cuid())
  name        String
  status      String       @default("DRAFT")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  auditLogs   AuditLog[]
  rounds      Round[]
  scoreEvents ScoreEvent[]
  teams       Team[]
}

model Team {
  id                String                 @id @default(cuid())
  eventId           String
  name              String
  joinCode          String
  score             Int                    @default(0)
  scoreReachedAt    DateTime?
  wallet            Int                    @default(0)
  qualified         Boolean                @default(false)
  round1StartedAt   DateTime?
  round1DeadlineAt  DateTime?
  round1Duration    Int                    @default(1800)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  hintClaims        HintClaim[]
  scoreEvents       ScoreEvent[]
  submissions       Submission[]
  event             Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  challengeAttempts TeamChallengeAttempt[]
  members           TeamMember[]

  @@unique([eventId, joinCode])
  @@unique([eventId, name])
  @@index([eventId, score(sort: Desc), scoreReachedAt])
  @@index([eventId])
  @@index([joinCode])
  @@index([round1DeadlineAt])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  phone     String?
  email     String?
  isLeader  Boolean  @default(false)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Round {
  id                String             @id @default(cuid())
  eventId           String
  name              String
  number            Int
  status            String             @default("DRAFT")
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auctionChallenges AuctionChallenge[]
  questions         Question[]
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scoreEvents       ScoreEvent[]

  @@index([eventId, number])
}

model Question {
  id              String       @id @default(cuid())
  roundId         String
  title           String
  description     String
  answer          String
  points          Int          @default(100)
  firstBloodBonus Int          @default(50)
  difficulty      String       @default("MEDIUM")
  category        String       @default("General")
  releaseAt       DateTime
  closeAt         DateTime
  batchNumber     Int          @default(1)
  answerMode      String       @default("TRIMMED")
  isActive        Boolean      @default(true)
  order           Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  round           Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  submissions     Submission[]

  @@index([roundId, batchNumber, order])
  @@index([roundId, order])
  @@index([roundId, isActive])
  @@index([releaseAt])
  @@index([closeAt])
}

model Submission {
  id              String   @id @default(cuid())
  teamId          String
  questionId      String
  submittedAnswer String
  isCorrect       Boolean
  isFirstBlood    Boolean  @default(false)
  submittedAt     DateTime @default(now())
  submittedBy     String?
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, questionId])
  @@index([teamId, questionId, isCorrect])
  @@index([questionId, isCorrect])
  @@index([submittedAt])
  @@index([teamId, submittedAt])
}

model ScoreEvent {
  id        String   @id @default(cuid())
  eventId   String
  teamId    String
  roundId   String?
  type      String
  points    Int
  reason    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round     Round?   @relation(fields: [roundId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([eventId, teamId])
  @@index([teamId, createdAt])
  @@index([eventId, createdAt])
  @@index([type])
}

model AuctionChallenge {
  id               String                 @id @default(cuid())
  roundId          String
  title            String
  description      String
  basePoints       Int                    @default(200)
  status           String                 @default("DRAFT")
  winningTeamId    String?
  committedSeconds Int?
  startedAt        DateTime?
  deadlineAt       DateTime?
  completedAt      DateTime?
  success          Boolean?
  failurePenalty   Int                    @default(100)
  order            Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  round            Round                  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  hints            Hint[]
  attempts         TeamChallengeAttempt[]

  @@index([roundId, order])
}

model Hint {
  id          String           @id @default(cuid())
  challengeId String
  title       String
  content     String
  cost        Int              @default(50)
  order       Int              @default(0)
  challenge   AuctionChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  claims      HintClaim[]

  @@index([challengeId, order])
}

model HintClaim {
  id        String   @id @default(cuid())
  teamId    String
  hintId    String
  cost      Int
  claimedAt DateTime @default(now())
  hint      Hint     @relation(fields: [hintId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, hintId])
  @@index([teamId])
}

model TeamChallengeAttempt {
  id              String           @id @default(cuid())
  teamId          String
  challengeId     String
  startedAt       DateTime
  deadlineAt      DateTime
  completedAt     DateTime?
  success         Boolean          @default(false)
  timeUsedSeconds Int?
  pointsAwarded   Int              @default(0)
  createdAt       DateTime         @default(now())
  challenge       AuctionChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, success])
  @@index([challengeId])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventId   String?
  teamId    String?
  actor     String   @default("SYSTEM")
  action    String
  details   String?
  createdAt DateTime @default(now())
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([actor, action])
}
