# Database connection URL (PostgreSQL)
# For Supabase Production: Use the connection pooler for DATABASE_URL (port 6543 with pgbouncer=true)
# Include connection_limit=1 for serverless (Vercel) deployment to prevent connection exhaustion
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct database URL for Prisma migrations (port 5432, no pgbouncer)
# Used by "prisma migrate deploy" and other migration commands
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase Configuration (Optional - for Realtime features)
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
# NEXT_PUBLIC_* variables are exposed to the browser
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Admin Authentication Credentials
ADMIN_EMAIL="admin@cipherchase.local"
ADMIN_PASSWORD="cipher-admin-secret-2026"

# Session Encryption Secret (at least 32 characters)
SESSION_SECRET="cipher-chase-super-secret-key-32-chars-long-2026"

# Public App Metadata
NEXT_PUBLIC_APP_NAME="Cipher Chase"
